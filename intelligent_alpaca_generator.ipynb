   "metadata": {},
   "source": [
    "## 📂 6. Dosyaları Bul ve İşle"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "8b4c2e9e",
   "metadata": {},
   "outputs": [],
   "source": [
    "text_chunks = []\n",
    "input_path = \"/kaggle/input\"\n",
    "if os.path.exists(input_path):\n",
    "    all_files = [os.path.join(root, file) for root, _, files in os.walk(input_path) for file in files if file.lower().endswith(('.txt', '.pdf'))]\n",
    "    print(f\"📚 {len(all_files)} adet dosya bulundu.\")\n",
    "    for file_path in tqdm(all_files, desc=\"Dosyalar işleniyor\"):\n",
    "        content = FileProcessor.read_file(file_path)\n",
    "        if content:\n",
    "            text_chunks.extend(FileProcessor.get_text_chunks(content))\n",
    "    print(f\"🎉 Toplam {len(text_chunks)} adet metin parçası oluşturuldu.\")\n",
    "else:\n",
    "    print(f\"⚠️ {input_path} bulunamadı. Lütfen Kaggle'a dataset yükleyin.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "22fe10d4",
   "metadata": {},
   "source": [
    "## 🚀 7. Dataset Üretimini Başlat"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "81675282",
   "metadata": {},
   "outputs": [],
   "source": [
    "# UI Widget'ları\n",
    "num_examples_widget = widgets.IntSlider(value=min(100, len(text_chunks)), min=1, max=min(35000, len(text_chunks)), step=10, description='Örnek Sayısı:')\n",
    "batch_size_widget = widgets.IntSlider(value=8, min=1, max=64, step=1, description='Batch Boyutu:')\n",
    "temperature_widget = widgets.FloatSlider(value=0.7, min=0.1, max=1.5, step=0.1, description='Temperature:')\n",
    "generate_button = widgets.Button(description='🚀 Üretimi Başlat', button_style='success')\n",
    "output_widget = widgets.Output()\n",
    "\n",
    "def run_generation_workflow(b):\n",
    "    with output_widget:\n",
    "        clear_output(wait=True)\n",
    "        print(\"⚙️ Üretim başlatılıyor...\")\n",
    "        if not text_chunks or not generator_pipeline:\n",
    "            print(\"❌ Model veya metin parçaları hazır değil!\")\n",
    "            return\n",
    "\n",
    "        # Config\n",
    "        num_examples = num_examples_widget.value\n",
    "        batch_size = batch_size_widget.value\n",
    "        temperature = temperature_widget.value\n",
    "        \n",
    "        # Generation\n",
    "        alpaca_gen = AlpacaGenerator(generator_pipeline, tokenizer)\n",
    "        selected_chunks = random.sample(text_chunks, min(num_examples, len(text_chunks)))\n",
    "        generated_dataset = []\n",
    "        for i in tqdm(range(0, len(selected_chunks), batch_size), desc=\"Batch'ler işleniyor\"):\n",
    "            batch_contexts = selected_chunks[i:i+batch_size]\n",
    "            batch_results = alpaca_gen.generate_batch(batch_contexts, temperature, max_len=256)\n",
    "            generated_dataset.extend(batch_results)\n",
    "        \n",
    "        print(f\"\\n🎉 {len(generated_dataset)} örnek üretildi.\")\n",
    "        \n",
    "        # Saving\n",
    "        output_dir = \"/kaggle/working/\"\n",
    "        os.makedirs(output_dir, exist_ok=True)\n",
    "        timestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n",
    "        print(f\"💾 Dosyalar şuraya kaydediliyor: {output_dir}\")\n",
    "        \n",
    "        # Save JSON and CSV\n",
    "        json_file = os.path.join(output_dir, f\"alpaca_dataset_{timestamp}.json\")\n",
    "        csv_file = os.path.join(output_dir, f\"alpaca_dataset_{timestamp}.csv\")\n",
    "        pd.DataFrame(generated_dataset).to_csv(csv_file, index=False)\n",
    "        with open(json_file, 'w', encoding='utf-8') as f:\n",
    "            json.dump(generated_dataset, f, ensure_ascii=False, indent=2)\n",
    "        print(f\"✅ {os.path.basename(json_file)} ve {os.path.basename(csv_file)} kaydedildi.\")\n",
    "        \n",
    "        # Download Links\n",
    "        print(\"\\n📥 İndirme Linkleri:\")\n",
    "        display(FileLink(json_file))\n",
    "        display(FileLink(csv_file))\n",
    "\n",
    "generate_button.on_click(run_generation_workflow)\n",
    "display(widgets.VBox([num_examples_widget, batch_size_widget, temperature_widget, generate_button, output_widget]))"
   ]
  }
