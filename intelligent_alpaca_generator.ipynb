   "source": [
    "## 🤖 4. LLM Modelinin Yüklenmesi"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7deaaa45",
   "metadata": {},
   "outputs": [],
   "source": [
    "MODEL_NAME = \"meta-llama/Llama-3.2-1B\"\n",
    "model, tokenizer, generator_pipeline = None, None, None\n",
    "\n",
    "def load_model_and_tokenizer():\n",
    "    global model, tokenizer, generator_pipeline\n",
    "    print(f\"🔄 {MODEL_NAME} modeli yükleniyor...\")\n",
    "    bnb_config = BitsAndBytesConfig(load_in_4bit=True, bnb_4bit_quant_type=\"nf4\", bnb_4bit_compute_dtype=torch.float16)\n",
    "    device_map = \"auto\"\n",
    "    if use_multi_gpu:\n",
    "        print(\"⚡ Multi-GPU device mapping aktif...\")\n",
    "        # Layer'ları manuel olarak dağıtmak yerine 'auto' kullanmak daha esnek ve sağlamdır.\n",
    "        # `accelerate` kütüphanesi en iyi dağılımı otomatik yapar.\n",
    "    model = AutoModelForCausalLM.from_pretrained(MODEL_NAME, quantization_config=bnb_config, device_map=device_map, trust_remote_code=True)\n",
    "    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, trust_remote_code=True)\n",
    "    if tokenizer.pad_token is None: tokenizer.pad_token = tokenizer.eos_token\n",
    "    generator_pipeline = pipeline(\"text-generation\", model=model, tokenizer=tokenizer, torch_dtype=torch.float16, device_map=\"auto\")\n",
    "    print(f\"✅ Model ve pipeline başarıyla yüklendi!\")\n",
    "\n",
    "load_model_and_tokenizer()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8dd6bbe6",
   "metadata": {},
   "source": [
    "## ⚙️ 5. Dosya İşleme ve Alpaca Üretim Sınıfları"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "85333ff9",
   "metadata": {},
   "outputs": [],
   "source": [
    "class FileProcessor:\n",
    "    @staticmethod\n",
    "    def read_file(file_path: str) -> str:\n",
    "        if file_path.lower().endswith('.pdf'):\n",
    "            try:\n",
    "                with pdfplumber.open(file_path) as pdf:\n",
    "                    return \"\\n\".join(page.extract_text() for page in pdf.pages if page.extract_text())\n",
    "            except Exception as e:\n",
    "                print(f\"❌ PDF okuma hatası: {e}\")\n",
    "                return \"\"\n",
    "        elif file_path.lower().endswith('.txt'):\n",
    "            try:\n",
    "                with open(file_path, 'r', encoding='utf-8') as f:\n",
    "                    return f.read()\n",
    "            except Exception as e:\n",
    "                print(f\"❌ TXT okuma hatası: {e}\")\n",
    "                return \"\"\n",
    "        return \"\"\n",
    "\n",
    "    @staticmethod\n",
    "    def get_text_chunks(text: str, chunk_size: int = 800) -> List[str]:\n",
    "        sentences = nltk.sent_tokenize(text)\n",
    "        chunks, current_chunk = [], \"\"\n",
    "        for sentence in sentences:\n",
    "            if len(current_chunk) + len(sentence) < chunk_size:\n",
    "                current_chunk += \" \" + sentence\n",
    "            else:\n",
    "                chunks.append(current_chunk.strip())\n",
    "                current_chunk = sentence\n",
    "        if current_chunk: chunks.append(current_chunk.strip())\n",
    "        return [c for c in chunks if len(c) > 50]\n",
    "\n",
    "class AlpacaGenerator:\n",
    "    def __init__(self, pipeline, tokenizer):\n",
    "        self.pipe = pipeline\n",
    "        self.tokenizer = tokenizer\n",
    "        self.instruction_templates = [\n",
    "            \"Create a thoughtful question from this text and provide a comprehensive answer:\", \"Extract the key concepts from this content:\",\n",
    "            \"Summarize this text focusing on its main points:\", \"Provide an explanation of the ideas in this text:\",\n",
    "            \"Identify and explain the main argument in this passage:\", \"Analyze the structure and reasoning in this text:\",\n",
    "            \"What are the practical implications of the ideas discussed?\", \"How do these concepts relate to broader topics?\",\n",
    "            \"What conclusions can be drawn from the information presented?\", \"Explain the significance of this content in its context:\"\n",
    "        ]\n",
    "\n",
    "    def generate_batch(self, contexts: List[str], temp: float, max_len: int) -> List[Dict]:\n",
    "        prompts = []\n",
    "        instructions = []\n",
    "        for context in contexts:\n",
    "            instruction = random.choice(self.instruction_templates)\n",
    "            prompts.append(f\"### Instruction:\\n{instruction}\\n\\n### Input:\\n{context}\\n\\n### Response:\\n\")\n",
    "            instructions.append(instruction)\n",
    "        \n",
    "        try:\n",
    "            responses = self.pipe(prompts, max_new_tokens=max_len, do_sample=True, temperature=temp, top_p=0.9, pad_token_id=self.tokenizer.eos_token_id)\n",
    "            results = []\n",
    "            for i, resp_list in enumerate(responses):\n",
    "                if resp_list and len(resp_list) > 0:\n",
    "                    output = resp_list[0]['generated_text'].replace(prompts[i], \"\").strip()\n",
    "                    results.append({\"instruction\": instructions[i], \"input\": contexts[i], \"output\": output})\n",
    "            return results\n",
    "        except Exception as e:\n",
    "            print(f\"❌ Batch generation hatası: {e}\")\n",
    "            if 'out of memory' in str(e).lower(): torch.cuda.empty_cache(); gc.collect()\n",
    "            return []\n",
    "print(\"✅ Sınıflar hazır.\")"
   ]
  },
  {
