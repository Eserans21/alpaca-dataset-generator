    "import torch, pandas as pd, numpy as np, json, os, re, gc\n",
    "from pathlib import Path\n",
    "from typing import List, Dict, Tuple\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "from transformers import AutoTokenizer, AutoModelForCausalLM, pipeline, BitsAndBytesConfig\n",
    "from huggingface_hub import login\n",
    "import pypdf, pdfplumber\n",
    "import nltk\n",
    "from tqdm.auto import tqdm\n",
    "from datetime import datetime\n",
    "import ipywidgets as widgets\n",
    "from IPython.display import display, HTML, clear_output, FileLink\n",
    "import zipfile, glob\n",
    "\n",
    "if torch.cuda.is_available():\n",
    "    num_gpus = torch.cuda.device_count()\n",
    "    print(f\"🔥 CUDA mevcut: {torch.cuda.is_available()}, {num_gpus} GPU bulundu.\")\n",
    "    for i in range(num_gpus):\n",
    "        print(f\"  💾 GPU {i}: {torch.cuda.get_device_name(i)}\")\n",
    "    use_multi_gpu = num_gpus >= 2\n",
    "else:\n",
    "    print(\"⚠️ GPU bulunamadı, CPU kullanılacak.\")\n",
    "    use_multi_gpu = False\n",
    "    num_gpus = 0\n",
    "\n",
    "try:\n",
    "    nltk.download('punkt', quiet=True)\n",
    "except:\n",
    "    pass\n",
    "print(\"✅ Kütüphaneler yüklendi.\")"
   ]
